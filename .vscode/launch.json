  "version": "0.2.0",
  "configurations": [
    {
      "name": "MPA Test",
      "type": "php",
      "request": "launch",
      "noDebug": false,
      "runtimeArgs": [
        "-S",
        "localhost:8000",
        "-t",
        "."
      ],
      "cwd": "${workspaceRoot}/tests/mpa/public",
      "serverReadyAction": {
        "action": "openExternally"
      }
    },
    {
      "name": "SPA Test",
      "type": "php",
      "request": "launch",
      "noDebug": false,
      "runtimeArgs": [
        "-S",
        "localhost:8000",
        "-t",
        "."
      ],
      "cwd": "${workspaceRoot}/tests/spa/public",
      "serverReadyAction": {
        "action": "openExternally"
      }
    },
    {
      "name": "Listen for Xdebug",
      "type": "php",
      "request": "launch"
    }
  ]
}